
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#09090d">
<title>AYVELOR NFC</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#09090d;color:#fff;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;min-height:100vh;padding:28px 20px}
.wrap{max-width:440px;margin:auto}
header{text-align:center;padding:30px 0 38px}
.logo{font-size:27px;font-weight:800;letter-spacing:7px;cursor:pointer}
.sub{color:#858590;font-size:12px;letter-spacing:3px;margin-top:9px}
.line{height:1px;background:#292932;margin:0 0 30px}
h1{font-size:27px;margin:0 0 10px}
.desc{color:#a3a3ad;line-height:1.6;margin:0 0 28px}
.links{display:grid;gap:12px}
.link{display:flex;align-items:center;justify-content:space-between;padding:18px 19px;border:1px solid #30303a;border-radius:16px;background:linear-gradient(135deg,#191922,#101016);color:white;text-decoration:none;font-size:15px}
.link span:last-child{color:#8c72ff;font-size:20px}
.wifi{margin-top:24px;padding:21px;border:1px solid #40336c;border-radius:18px;background:linear-gradient(145deg,#21183a,#111018)}
.wifi h2{font-size:17px;margin:0 0 17px}
.wrow{display:flex;justify-content:space-between;gap:12px;margin:12px 0;color:#aaa9b6;font-size:13px}
.wrow strong{color:white;text-align:right;overflow-wrap:anywhere}
.copy{width:100%;padding:14px;margin-top:12px;border:0;border-radius:12px;background:#7655ed;color:white;font-weight:700;font-size:14px}
footer{text-align:center;color:#666673;font-size:11px;letter-spacing:2px;margin:40px 0 15px}
#admin{display:none;margin-top:28px;padding:20px;border:1px solid #40336c;border-radius:16px;background:#15131e}
#admin input{width:100%;padding:12px;margin:6px 0 12px;border-radius:9px;border:1px solid #393541;background:#09090d;color:white}
#admin button{padding:12px;border:0;border-radius:9px;background:#7655ed;color:white;font-weight:bold}
</style>
</head>
<body>
<div class="wrap">
<header>
<div class="logo" id="logo">AYVELOR</div>
<div class="sub">YOUR DIGITAL SPACE</div>
</header>
<div class="line"></div>
<main>
<h1 id="venue">Welcome</h1>
<p class="desc" id="description">Добро пожаловать! Здесь собраны наши контакты и полезные ссылки.</p>
<div class="links" id="links">
<a class="link" id="telegram" href="https://t.me/" target="_blank"><span>Telegram</span><span>↗</span></a>
<a class="link" id="instagram" href="https://instagram.com/" target="_blank"><span>Instagram</span><span>↗</span></a>
<a class="link" id="vk" href="https://vk.com/" target="_blank"><span>ВКонтакте</span><span>↗</span></a>
<a class="link" id="maps" href="https://yandex.ru/maps/" target="_blank"><span>Яндекс Карты</span><span>↗</span></a>
</div>
<section class="wifi">
<h2>Guest Wi-Fi</h2>
<div class="wrow"><span>NETWORK</span><strong id="ssid">AYVELOR_GUEST</strong></div>
<div class="wrow"><span>PASSWORD</span><strong id="password">welcome2026</strong></div>
<button class="copy" id="copy">Скопировать пароль Wi-Fi</button>
</section>
<section id="admin">
<h2>Настройки заведения</h2>
<label>Название</label><input id="editVenue">
<label>Описание</label><input id="editDescription">
<label>Telegram URL</label><input id="editTelegram">
<label>Instagram URL</label><input id="editInstagram">
<label>VK URL</label><input id="editVk">
<label>Яндекс Карты URL</label><input id="editMaps">
<label>Wi-Fi имя сети</label><input id="editSsid">
<label>Wi-Fi пароль</label><input id="editPassword">
<button id="save">Сохранить изменения</button>
</section>
</main>
<footer>POWERED BY AYVELOR NFC</footer>
</div>
<script>
const defaults={
venue:"Welcome",
description:"Добро пожаловать! Здесь собраны наши контакты и полезные ссылки.",
telegram:"https://t.me/",
instagram:"https://instagram.com/",
vk:"https://vk.com/",
maps:"https://yandex.ru/maps/",
ssid:"AYVELOR_GUEST",
password:"welcome2026"
};
let data={...defaults,...JSON.parse(localStorage.getItem("ayvelor")||"{}")};
const fields=["venue","description","telegram","instagram","vk","maps","ssid","password"];
function render(){
document.getElementById("venue").textContent=data.venue;
document.getElementById("description").textContent=data.description;
["telegram","instagram","vk","maps"].forEach(id=>document.getElementById(id).href=data[id]);
document.getElementById("ssid").textContent=data.ssid;
document.getElementById("password").textContent=data.password;
}
render();
document.getElementById("copy").onclick=async()=>{
try{await navigator.clipboard.writeText(data.password);document.getElementById("copy").textContent="Пароль скопирован ✓"}
catch(e){prompt("Скопируйте пароль:",data.password)}
};
let taps=0,timer;
document.getElementById("logo").onclick=()=>{
taps++;clearTimeout(timer);timer=setTimeout(()=>taps=0,1800);
if(taps>=5){taps=0;const p=prompt("Admin password");
if(p==="1234"){document.getElementById("admin").style.display="block";
fields.forEach(k=>document.getElementById("edit"+k.charAt(0).toUpperCase()+k.slice(1)).value=data[k]);
}else if(p!==null)alert("Неверный пароль");}
};
document.getElementById("save").onclick=()=>{
fields.forEach(k=>data[k]=document.getElementById("edit"+k.charAt(0).toUpperCase()+k.slice(1)).value.trim());
localStorage.setItem("ayvelor",JSON.stringify(data));render();alert("Изменения сохранены на этом устройстве");
};
</script>
</body>
</html>

